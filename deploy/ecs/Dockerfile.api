FROM public.ecr.aws/docker/library/python:3.14-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY agent-learning/pyproject.toml agent-learning/uv.lock agent-learning/README.md ./
RUN uv sync --locked --no-dev --no-cache --python /usr/local/bin/python
COPY agent-learning/app ./app
COPY agent-learning/db ./db
RUN useradd --uid 10001 --create-home appuser
USER appuser
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
